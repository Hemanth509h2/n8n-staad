# Copy to .env and fill in N8N_ENCRYPTION_KEY and DB_POSTGRESDB_PASSWORD.
#
# Local:  docker run -it --rm -p 5678:5678 --env-file .env n8n-staad
# Render: Environment -> "Add from .env" and paste this file.
#
# No quotes around values: docker --env-file would keep them literally.

# Render routes traffic to this port. render-entrypoint.sh copies it to N8N_PORT.
PORT=5678

# Encrypts saved credentials. Generate with `openssl rand -base64 32`, use the
# same value everywhere, keep a copy, and never change it, or every saved
# credential becomes unreadable.
N8N_ENCRYPTION_KEY=

# Neon (shared with the backend and feedback-board). n8n's tables go in the
# "n8n" schema. Direct host only, never the "-pooler" one.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=ep-bold-butterfly-aox1gpwj.c-2.ap-southeast-1.aws.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=neondb_owner
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_CONNECTION_TIMEOUT=30000

# Keep execution history to 7 days.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
