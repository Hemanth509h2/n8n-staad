# Copy to .env and fill in the two secrets. Everything else (Neon host, user,
# schema, SSL, time zone, ...) is already baked into the Dockerfile.
#
# Render: Environment -> Secret Files -> add a file named `.env` with this
#         content. render-entrypoint.sh loads /etc/secrets/.env on startup.
# Local:  docker run -it --rm -p 5678:5678 --env-file .env n8n-staad
#
# No quotes needed around values.

# Encrypts saved credentials. Generate with `openssl rand -base64 32`, keep a
# copy, and never change it, or every saved credential becomes unreadable.
N8N_ENCRYPTION_KEY=

# Password of the Neon neondb_owner user.
DB_POSTGRESDB_PASSWORD=

# Any other n8n setting can go here too and overrides the Dockerfile default,
# e.g. N8N_WEBHOOK_URL=https://n8n.example.com/ for a custom domain.
